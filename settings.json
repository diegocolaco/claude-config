{
  "env": {
    "MCP_TIMEOUT": "120000",
    "MCP_TOOL_TIMEOUT": "180000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "haiku",
  "statusLine": {
    "type": "command",
    "command": "\"/usr/local/bin/node\" \"/home/diego/.claude/.claude-manager/statusline-tap.js\""
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "promptCacheTtl": "1h",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 200000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "low"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 100000
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 300000,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
